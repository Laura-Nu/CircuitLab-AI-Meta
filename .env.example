APP_ENV=development
APP_ORIGIN=http://localhost:8080
DATABASE_URL=postgresql+psycopg://circuitlab:CHANGE_ME@postgres:5432/circuitlab
POSTGRES_USER=circuitlab
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=circuitlab
STORAGE_ROOT=/data/evidence
# meta or simulation. Simulation is explicitly labelled and forbidden in production.
AI_MODE=meta
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
# Set the exact model enabled for your account. No fallback model is silently selected.
META_REASONING_MODEL=
# meta, baseten or self_hosted. Baseten uses its official URL and an 8-image limit.
META_PROVIDER=meta
META_TIMEOUT_SECONDS=60
# Optional retrospective story: disabled, meta (Muse Wonder), simulation (development only).
STORYBOARD_MODE=disabled
STORYBOARD_API_KEY=
STORYBOARD_MODEL=muse-wonder-1.0
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
MAX_UPLOAD_MB=10
MAX_ANALYSIS_STEPS=8
WORKER_LEASE_SECONDS=120
HARDWARE_COMMAND_TIMEOUT_SECONDS=10
# Password recovery via Resend HTTPS API. Requires a key and a verified sender.
# Other modes: disabled, file (development only), smtp (optional legacy delivery).
RECOVERY_DELIVERY=resend
RECOVERY_DIRECTORY=./data/recovery
RECOVERY_TTL_MINUTES=20
RESEND_API_KEY=
RESEND_FROM=
# Optional legacy SMTP; unused when RECOVERY_DELIVERY=resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
