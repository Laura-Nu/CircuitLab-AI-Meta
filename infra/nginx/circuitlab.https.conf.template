# CircuitLab only. Install after the domain certificate exists.
server {
    listen 80;
    server_name @@DOMAIN@@;
    location ^~ /.well-known/acme-challenge/ {
        root @@ROOT@@/.acme;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name @@DOMAIN@@;
    ssl_certificate /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root @@ROOT@@/build/site;
    index index.html;
    client_max_body_size 12m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location ~ /\. { deny all; }
    include @@ROOT@@/infra/nginx/circuitlab.performance.inc;
    location / { try_files $uri $uri/ /index.html; }
    location /app/ { try_files $uri $uri/ /app/index.html; }
    location = /api/v1/devices/connect {
        gzip off;
        proxy_pass http://127.0.0.1:@@API_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
    }
    location /api/ {
        gzip off;
        proxy_pass http://127.0.0.1:@@API_PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 90s;
        proxy_request_buffering on;
        proxy_cache off;
    }
}
